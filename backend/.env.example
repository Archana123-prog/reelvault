# Server configuration
PORT=5000
NODE_ENV=development

# Database (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/reelvault?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_jwt_secret_key_min_32_characters_long_for_security
JWT_EXPIRES_IN=7d

# Allowed frontend origins for CORS (comma separated if multiple)
CLIENT_URL=http://localhost:5173,https://your-reelvault-frontend.vercel.app
