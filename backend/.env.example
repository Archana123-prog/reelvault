# Server configuration
PORT=5000
NODE_ENV=development

# Database: Neon DB (PostgreSQL) Connection String
# Get yours from https://console.neon.tech -> Connection Details
DATABASE_URL=postgresql://<username>:<password>@<ep-name-123456>.us-east-2.aws.neon.tech/neondb?sslmode=require

# Authentication
JWT_SECRET=your_jwt_secret_key_min_32_characters_long_for_security
JWT_EXPIRES_IN=7d

# Allowed frontend origins for CORS (comma separated if multiple)
CLIENT_URL=http://localhost:5173,https://your-reelvault-frontend.vercel.app
